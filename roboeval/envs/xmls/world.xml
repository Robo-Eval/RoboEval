<?xml version="1.0"?>
<mujoco model="world">
  <option integrator="implicitfast">
    <flag multiccd="enable"/>
  </option>
  <statistic center="0 0 1" extent="1.8"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <body name="floor">
      <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    </body>
    <!-- Close operator-eye-level camera ported from RoboEval@telearms world.xml.
         Keeps frames framed on the workspace rather than the wide overhead
         view the original playground used. -->
    <!-- Egocentric "behind the bot" operator camera: sits centered behind
         the robot (negative X, Y=0), roughly at head height, tilted down
         ~18° so the workspace sits comfortably in frame.
         xyaxes: cam-right = world -Y ; cam-up = (+X, 0, +Z) for downtilt. -->
    <camera name="external" mode="fixed" pos="-0.800 0.000 1.500" xyaxes="0.000 -1.000 0.000 0.316 0.000 0.949" fovy="60"/>
  </worldbody>
</mujoco>
