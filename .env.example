# =============================================================================
# telearms-roboplayground — Telearms integration environment variables
# Copy to .env and fill in values. Only needed for `input_mode=Telearms`.
# =============================================================================

# --- Instance identity ---
# Unique id for this simulation worker (e.g. THORSIM-001). Auto-generated if unset.
INSTANCE_ID=

# --- TeleArms WebSocket server (control plane: start/stop/reset/preload) ---
WS_SERVER_URL=wss://telearms-ws-server.onrender.com
TELEARMS_WS_API_KEY=your_ws_api_key_here

# --- TeleArms backend (issues Agora tokens per task_id) ---
TELEARMS_BACKEND_URL=https://telearms-backend-staging.onrender.com
TELEARMS_BACKEND_API_KEY=your_backend_api_key_here

# --- MuJoCo / Display (only required when rendering headlessly, e.g. EC2) ---
# DISPLAY=:99
# MUJOCO_GL=egl
